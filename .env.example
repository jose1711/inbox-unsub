# --- Mailbox / Schránka -----------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your.name@gmail.com
# Gmail: an app password (16 chars, no spaces), NOT your normal password
# Gmail: heslo pre aplikácie (16 znakov, bez medzier), NIE bežné heslo
IMAP_PASSWORD=abcdabcdabcdabcd

# Comma-separated folders to scan / Priečinky na kontrolu, oddelené čiarkou
IMAP_FOLDERS=INBOX

# Where "move to spam" puts mail; empty = feature disabled.
# Find the exact name with: docker compose run --rm inbox-unsub python app.py --list-folders
# Kam presúvať spam; prázdne = funkcia vypnutá. Gmail zvyčajne: [Gmail]/Spam
JUNK_FOLDER=

# --- Behaviour / Správanie --------------------------------------------------
# Scan interval in minutes (min. 5) / Ako často skenovať (minúty)
SCAN_INTERVAL_MIN=60
# How many days back the very first scan looks / Koľko dní dozadu pri prvom skenovaní
INITIAL_DAYS=30
# Days of tolerance after unsubscribing before a sender is flagged
# Koľko dní po odhlásení tolerovať e-maily, kým sa odosielateľ označí „znova píše“
GRACE_DAYS=3
# Score needed to record an unknown sender (3 = has an unsubscribe link)
# Minimálne skóre pre zápis neznámeho odosielateľa
MIN_SCORE=3

# Time zone used to display dates / Časové pásmo pre zobrazenie dátumov
TZ=Europe/Bratislava

# --- Web UI / Webové rozhranie ----------------------------------------------
WEB_USER=admin
WEB_PASSWORD=change-me
